{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "english-web"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-db",
      "database_id": "7b35a676-02f7-40e1-b754-e175dd26ed00"
    }
  ],
  "ratelimits": [
    {
      "name": "ATTEMPTS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
